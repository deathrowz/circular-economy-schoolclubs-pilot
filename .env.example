# I2I Clubs (Idea2Impact) • GIZ Sri Lanka 15-School Pilot Platform
# Environment Configuration (.env.example)
#
# Compliance:
# - Target Host: Vercel Frankfurt (fra1) exclusively (EU GDPR / AVV compliant)
# - Database & Storage: Supabase Frankfurt (eu-central-1)
# - Inbound Pipeline: WhatsApp Cloud API (Graph API v20.0+)
# - Zero Singapore OCI (168.107.65.183) proxying or non-EU routing
# ============================================================================

# 1. Supabase Frankfurt (eu-central-1) Configuration
NEXT_PUBLIC_SUPABASE_URL=https://dqrdhvrunmnufxpcxnuq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Supabase Storage (Private Ingestion Bucket: i2i-proofs)
SUPABASE_STORAGE_BUCKET=i2i-proofs

# 3. WhatsApp Cloud API v20.0+ (Meta Graph API)
# Webhook verification token configured in Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=i2i-clubs-verify-token-2026

# Meta App Secret used to compute & verify X-Hub-Signature-256 HMAC
WHATSAPP_APP_SECRET=your-meta-app-secret-32-chars

# System User Permanent Access Token with whatsapp_business_messaging & whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=EAAG...your-meta-system-user-access-token

# Meta Phone Number ID (from WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=109283746501928

# WhatsApp Business Account ID (WABA)
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765

# 4. Web Application Host URL (Production OCI Host / Staging)
NEXT_PUBLIC_APP_URL=https://161.118.247.101.sslip.io
