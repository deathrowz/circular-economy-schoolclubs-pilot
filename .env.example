# Supabase Configuration (PostgreSQL + Auth + RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# S3-Compatible Storage Configuration (AWS S3 / Cloudflare R2 / MinIO / Supabase Storage S3)
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET_NAME=circular-enterprise-evidence
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_PUBLIC_URL_BASE=https://circular-enterprise-evidence.s3.us-east-1.amazonaws.com

# Telegram Bot Configuration (Client 1 - Student Data Entry)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=circular-pilot-secret-token
NEXT_PUBLIC_APP_URL=http://localhost:3000
